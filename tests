require "atmos.env.pico"
val pico = require "pico"

func tic(){
   every :draw{ 
     print("5")
   }
}

val color = @{
    bg = 'white',
    fg = 'black',
}

pico.zet.window @{ title="Apresentação" }
pico.zet.dim @{'!', w=800, h=600}
pico.zet.pencil @{
    font = "DejaVuSans.ttf"
}

pin x = if 10 < 20{
        spawn tic()
    }
    else {
        print("hello")
    }
print(x,"1")

loop {
     pico.zet.effect @{
        color = (color && color.bg) || color.bg
    } 
    par {
       print(x,"2") 
       loop {
          val _,e = await :key.dn
           match e.key {
              :Escape => {
                 return()
               }
            }
         }
     }
}

