func ITS.List (t) {
    var n = #t
    var currentLayer = nil
    
    -- Function to create/update the text layer
    func updateTextLayer() {
        -- Remove old layer if exists
        if currentLayer ~= nil {
            pico.layer.remove(currentLayer)
        }
        
        -- Create new layer
        pico.layer.empty(nil,"textlist"++lay,false,@{'!',w=800,h=800})
        pico.zet.layer("textlist"++lay)
        set currentLayer = lay
        set lay = lay+1
        
        -- Draw all items with selection indicator
        loop i in #t {
            pico.output.draw.text(t[i], @{
                '%', x=0.1, y=0.15+(i*0.075), h=0.05, anchor=:W
            })
            
            -- Draw selection oval only for current selection
            if i == n {
                pico.output.draw.oval(@{
                    '%', x=0.05, y=0.15+(i*0.075), h=0.02, w=0.02, anchor=:W
                })
            }
        }
        
        pico.zet.layer("world")
    }
    
    par{
       if (t.anim){
          updateTextLayer() -- Initial draw
          
          loop{
             val _,e = await :key.dn
             match e.key{
                :Up => {
                   if n > 0{
                      set n = n-1
                      updateTextLayer() -- Redraw with new selection
                   }
                }
                :Down =>{
                   if n < #t {
                      set n = n+1
                      updateTextLayer() -- Redraw with new selection
                   }
                }
             }
          }
       }
    }with{
       every :draw {
           -- Just render the current text layer
           if currentLayer ~= nil {
               pico.output.draw.layer("textlist"++currentLayer,@{
                   '%', x=0, y=0, anchor=:NW
               })
           }
       }
    }
}
