val ITS = []

set ITS.Queue = task (t) {
   
   val list = []   
   
   par{
      loop{
         val e = await :key.dn
         match e.key{
            :Q => {
               loop {
               val e = await :key.dn
;;-> TODO: CONVERTER PARA QUALQUER NÚMERO
;;-> TODO: NAO PERMITIR ARGUMENTO REPETIDO

                  match e.key {
                     :1 =>{
                        set list@+ = t@1
                     }
                     :2 =>{
                        set list@+ = t@2
                     }
                     :3 =>{
                        set list@+ = t@3
                     }
                     :Q =>{
                        break()
                     }
                  }
               }
            }
         }
      }
   }with{
      loop on :draw {
         loop i,v in list {
            pico.output.draw.text(v,[
               '%', x=0.1, y=0.15+(i*0.075),h=0.05,anchor=:W
            ])
         }
      }
   }
}

set ITS.ListL = task (t) {

   if t.anim {
       set n = 0
    } else {
       set n = #t
    }
   var lisLay

   func updateLayer(){

;;Layer information
;;==============================================================
      pico.layer.empty(nil,"list"++lay,false,['!',w=800,h=600])
      pico.set.layer("list"++lay)
      set lisLay = lay
      set lay = lay+1
      pico.set.pencil [color = 0x000000]
      pico.set.pencil [font = "DejaVuSans.ttf"]
;;==============================================================

      val skip = (t.skip || 0.075) * (t.size || 1)
      val margin_left = 0.05
      val margin_top = 0.05

      var base_x = margin_left
      var base_y = margin_top
      
      if (t.btitle) {
         pico.output.draw.text(t.btitle,[
            '%',x=0.05,y=0.15 + skip,h=0.055, anchor=:W
         ])
         set base_y = base_y + skip
      }

      var base_text_height = 0.05
      var base_line_space  = 0.075

      var text_height = base_text_height * (t.size || 1)

      val start_index = (t.btitle && 1) || 0
      loop i in n {
         pico.output.draw.text(t@i,[
            '%',x=0.1,y=0.15+((i+start_index)*skip),h=text_height,anchor=:W
         ])
       }
       if (((t.bullet == nil) && true) || t.bullet){
          loop i in n{
             pico.output.draw.oval ['%',x=0.05,y=0.15+((i+start_index)*skip),h=(0.02 * (t.size || 1)),w=(0.02 * (t.size || 1)),anchor=:W]
          }
       }
       pico.set.layer("world")
    }
    updateLayer()

    var cell_x = t.xpos 
    var cell_y = t.ypos 
    var cell_width = t.width 
    var cell_height = t.height 

    var content_start_x = 0.5
    var content_start_y = 0.35

    var parent = [
       '%',
       x = cell_x - (cell_width / 2),
       y = cell_y - (cell_height / 2),
       w = cell_width,
       h = cell_height
    ]

    var child = [
       '%',
       x = content_start_x,  
       y = content_start_y  
    ]

    var pos = pico.xin.pos(parent,child)
    
    par{
      if (t.anim){
         loop{
            val  e = await :key.dn
            match e.key{
               :Up => {
                  if n > 0 {
                     set n = n-1
                     updateLayer()
                  }
                }
                :Down => {
                   if n < #t{
                     set n = n+1
                     updateLayer()
                   }
                }
             }
          }
      }

   }with{
      loop on :draw {
         await :Ok
         pico.output.draw.layer("list"++lisLay,[
            '%',x=pos.x,y=pos.y,anchor=:NW
         ])
      }
   }
}


set ITS.TextL = task (t) {

