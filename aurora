require "atmos.env.pico"
val pico = require "pico"

val color = @{
    bg = 'white',
    fg = 'black',
}

pico.zet.window @{ title="Apresentação" }
pico.zet.dim @{'!', w=800, h=600}
pico.zet.pencil @{
    font = "DejaVuSans.ttf"
}

val filename = ...
val T = dofile(filename)
 
val ITS = @{}
func ITS.List (t) {
    every :draw {
        loop i in #t {
            pico.output.draw.text(t[i], @{
                '%', x=0.1, y=0.15+(i*0.075), h=0.05, anchor=:W
            })
        }
    }
}

func ITS.Text (t) {
   every :draw {
      pico.output.draw.text(t[1], @{
         '%', x=0.2,y=0.2,h=0.05
}) 
   }
}

func ITS.Image (t) {
   every :draw {
      pico.output.draw.image(t[1], @{
          '%', x=0.5,y=0.5,h=0.5,w=0.5
      })
   }
}

val TPL = @{}
func TPL.Cover (t) {
    every :draw {
        pico.zet.pencil @{
            color = (t.color && t.color.fg) || color.fg
        }

        ;; title, subtitle
        pico.output.draw.text(t.title || "", @{
            '%', x=0.5, y=0.2, h=0.1
        })
        pico.output.draw.text(t.subtitle || "", @{
            '%', x=0.5, y=0.3, h=0.075
        })

        ;; author, institution, date
        pico.output.draw.text(t.author || "", @{
            '%', x=0.5, y=0.7,  h=0.05
        })
        pico.output.draw.text(t.inst || "", @{
            '%', x=0.5, y=0.75, h=0.05
        })
        pico.output.draw.text(t.date || "", @{
            '%', x=0.5, y=0.8,  h=0.05
        })
    }
}

func TPL.One (t) {
    val one = t[1]
print(one.tag)
    spawn ITS[one.tag](one)
    every :draw {
        pico.zet.pencil @{
            color = (t.color && t.color.fg) || color.fg
        }
        pico.output.draw.text(t.title || "", @{
            '%', x=0.5, y=0.1, h=0.075
        })
    }
}

var cur = 1
loop {
    print(:cur, cur)
    val t = T[cur]
    pico.zet.effect @{
        color = (t.color && t.color.bg) || color.bg
    }
    spawn TPL[t.template](t)
    loop {
        val _,e = await :key.dn
        match e.key {
            :Left => {
                if cur > 1 {
                    set cur = cur - 1
                    break()
                }
            }
            :Right => {
                if cur < #T {
                    set cur = cur + 1
                    break()
                }
            }
            :Escape => {
                return()
            }
        }
        
    }
}
