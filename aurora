set TPL.Ref = task (t) {
  
   var cur_idx = 1
   var tot_ref = #t
   var current_ref = t@cur_idx

   task drawRef(ref){
      loop on :draw{
         pico.set.pencil [
            color = color.fg
         ]
         pico.output.draw.text("REFERENCES", [
            '%',x=0.5,y=0.08,h=0.075
         ])

         pico.output.draw.text(ref.title,[
            '%', x=0.5, y=0.3,h=0.05
         ])

         var author_text = table.concat(ref.author, "; ")
         pico.output.draw.text(author_text,[
            '%',x=0.5,y=0.4,h=0.04
         ])
 
         pico.output.draw.text(cur_idx++"/"++tot_ref,[
            '%', x=0.85, y=0.08,h=0.06,anchor = :E
         ])
      }
   }

   loop{
      par :any{
         val e = await :key.dn
         match e.key {
            :Down=>{
               if (cur_idx <= 1) => break() ;;possibilidade de continue?
               set cur_idx = cur_idx - 1
               set current_ref = t@cur_idx
            }
            :Up=>{
               if (cur_idx >= #t) => break()
               set cur_idx = cur_idx + 1
               set current_ref = t@cur_idx
            }
         }
      }with{
         loop on :draw{
	    pico.set.pencil [color = t.bgcolor || color.bg]
	    pico.output.draw.rect ['%',x=0.5,y=0.5,w=1,h=1]
         }
      }with{
         spawn drawRef(t@cur_idx)
         await(false)
      }
   }
}

set TPL.Grid = task (t) {
   
   task draw_bg(c){
      loop on :draw{
         pico.set.pencil [color = c || color.bg]
         pico.output.draw.rect ['%',x=0.5,y=0.5,w=1,h=1]
      }
   }
  
   var total_rows = #t
   var total_cols = 0
   
   pin grid_objects = tasks()

   loop i in total_rows{
      var row = t@i
      if #row > total_cols{
         set total_cols = #row
      }
   }

   var title_height = 0.15
   var cell_width = 1.0 / total_cols
   var cell_height = (1.0 - title_height) / total_rows

   spawn draw_bg(t.bgcolor)

      loop row_idx in total_rows{
         var row = t@row_idx
         loop col_idx in #row{
            var item = row@col_idx
            if item {
               var cell_x = ((col_idx - 1) * cell_width) + (cell_width/2)
               var cell_y = title_height + ((row_idx - 1) * cell_height) + (cell_height/2)

               set item.xpos = cell_x
               set item.ypos  = cell_y
               set item.width = cell_width
               set item.height = cell_height

               set item.grid_row = row_idx
               set item.grid_col = col_idx
               set item.total_rows = total_rows
               set item.total_cols = total_cols
               set item.title_height = title_height

               spawn @grid_objects ITS@(item.tag)(item)
            }
         }
      }


      loop on :draw{
         pico.set.pencil [color = (t.color && t.color.fg) || color.fg]
         pico.output.draw.text(t.title || "",[
            '%',x=0.5,y=0.1,h=0.075
         ])
         emit :Ok
      }
}

var cur = 1
loop {
    print(:cur, cur)
    val t = T@cur
    pico.set.effect [
        color = (t.color && t.color.bg) || color.bg
    ]
    spawn TPL@(t.template)(t)
    loop {
        val e = await :key.dn
        match e.key {
            :Left => {
                if cur > 1 {
                    set cur = cur - 1
                    break()
                }
            }
            :Right => {
                if cur < #T {
                    set cur = cur + 1
                    break()
                }
            }
            :Escape => {
                return()
            }
        }
        
    }
}
