    spawn ITS[one.tag](one)
    spawn ITS[two.tag](two)

    loop on :draw {
        pico.set.pencil [
           color = (t.color && t.color.fg) || color.fg
        ]
        pico.output.draw.text(t.title || "", [
           '%',x=0.5,y=0.1,h=0.075
        ])
        pico.set.pencil [
           color = "black"
        ]
    }
}

var cur = 1
loop {
    print(:cur, cur)
    val t = T@cur
    pico.set.effect [
        color = (t.color && t.color.bg) || color.bg
    ]
    spawn TPL@(t.template)(t)
    loop {
        val _,e = await :key.dn
        match e.key {
            :Left => {
                if cur > 1 {
                    set cur = cur - 1
                    break()
                }
            }
            :Right => {
                if cur < #T {
                    set cur = cur + 1
                    break()
                }
            }
            :Escape => {
                return()
            }
        }
        
    }
}
