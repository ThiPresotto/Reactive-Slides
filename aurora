func TPL.Two(t) { 
    val one = t[1]
    val two = t[2]
    set one.pos = "left"
    set two.pos = "right"
    spawn ITS[one.tag](one)
    spawn ITS[two.tag](two)

    every :draw {
        pico.zet.pencil @{
           color = (t.color && t.color.fg) || color.fg
        }
        pico.output.draw.text(t.title || "", @{
           '%',x=0.5,y=0.1,h=0.075
        })
        pico.zet.pencil @{
           color = "black"
        }
        pico.output.draw.rect @{
           '%',x=0.5,y=0,h=1,w=0.05,anchor = :N
        }
    }
}

var cur = 1
loop {
    print(:cur, cur)
    val t = T[cur]
    pico.zet.effect @{
        color = (t.color && t.color.bg) || color.bg
    }
    spawn TPL[t.template](t)
    loop {
        val _,e = await :key.dn
        match e.key {
            :Left => {
                if cur > 1 {
                    set cur = cur - 1
                    break()
                }
            }
            :Right => {
                if cur < #T {
                    set cur = cur + 1
                    break()
                }
            }
            :Escape => {
                return()
            }
        }
        
    }
}
