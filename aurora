func ITS.Image (t) {
   val img = pico.get.image(t[1]) 
   var dh, dw
   if img.w >= img.h {
      set dw = 0.5
      val f = 0.5/img.w
      set dh = img.h * f 
   }
   else {
      set dh = 0.5
      val f = 0.5/img.h
      set dw = img.w * f
   }
every :draw {
      pico.output.draw.image(t[1], @{
		  '%', x=0.5,y=0.5,w=dw,h=dh
      })
   }
}

func ITS.ImageL (t) {
   pico.layer.empty(nil,"image"++lay,false,@{'!',w=800,h=600})
   pico.zet.layer("image"++lay)
   set imaLay = lay
   set lay = lay + 1

   val img = pico.get.image(t[1])
   var dh,dw
   if img.w >= img.h {
      set dw = 0.5
      val f = 0.5/img.w
      set dh = img.h * f
   }
   else {
      set dh = 0.5
      val f = 0.5/img.h
      set dw = img.w * f
   }
   pico.output.draw.image(t[1],@{
      '%',x=0.5,y=0.5,w=1,h=1
   })
   pico.zet.layer("world")

   var xpos = 0.5
   var ypos = 0.5
   var width = dw
   var height = dh

   ifs{
      t.pos == :left => {
         set xpos = 0.25
         set width = dw * 0.8
         set height = dh * 0.8
      }
      t.pos == :right => {
         set xpos = 0.75
         set width = dw * 0.8
         set height = dh * 0.8
      }
   }

   every :draw{
      pico.output.draw.layer("image"++imaLay, @{
          '%',x=xpos,y=ypos,w=width,h=height
      })
   }
}

val TPL = @{}
func TPL.Cover (t) {
    every :draw {
        pico.zet.pencil @{
            color = (t.color && t.color.fg) || color.fg
        }

        ;; title, subtitle
        pico.output.draw.text(t.title || "", @{
            '%', x=0.5, y=0.2, h=0.1
        })
        pico.output.draw.text(t.subtitle || "", @{
            '%', x=0.5, y=0.3, h=0.075
        })

        ;; author, institution, date
        pico.output.draw.text(t.author || "", @{
            '%', x=0.5, y=0.7,  h=0.05
        })
        pico.output.draw.text(t.inst || "", @{
            '%', x=0.5, y=0.75, h=0.05
        })
        pico.output.draw.text(t.date || "", @{
            '%', x=0.5, y=0.8,  h=0.05
        })
    }
}

