set ITS.Image = task (t) {
   val img = pico.get.image(t[1]) 
   var dh, dw
   if img.w >= img.h {
      set dw = 0.5
      val f = 0.5/img.w
      set dh = img.h * f 
   }
   else {
      set dh = 0.5
      val f = 0.5/img.h
      set dw = img.w * f
   }
   loop on :draw {
      pico.output.draw.image(t[1], [
         '%', x=0.5,y=0.5,w=dw,h=dh
      ])
   }
}

set ITS.ImageL = task (t) {
   pico.layer.empty(nil,"image"++lay,false,['!',w=800,h=600])
   pico.set.layer("image"++lay)
   var imaLay = lay
   set lay = lay + 1

   val img = pico.get.image(t[1])
   var dh,dw
   if img.w >= img.h {
      set dw = 0.5
      val f = 0.5/img.w
      set dh = img.h * f
   }
   else {
      set dh = 0.5
      val f = 0.5/img.h
      set dw = img.w * f
   }
   pico.output.draw.image(t[1],[
      '%',x=0.5,y=0.5,w=1,h=1
   ])
   pico.set.layer("world")

   var xpos = 0.5
   var ypos = 0.5
   var width = dw
   var height = dh

   ifs{
      t.pos == :left => {
         set xpos = 0.25
         set width = dw * 0.8
         set height = dh * 0.8
      }
      t.pos == :right => {
         set xpos = 0.75
         set width = dw * 0.8
         set height = dh * 0.8
      }
   }

   loop on :draw{
      pico.output.draw.layer("image"++imaLay, [
          '%',x=xpos,y=ypos,w=width,h=height
      ])
   }
}

val TPL = []
