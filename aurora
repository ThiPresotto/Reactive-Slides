func ITS.ListL (t) {

   if t.anim {
       set n = 0
    } else {
       set n = #t
    }
   var lisLay

   func updateLayer(){
      pico.layer.empty(nil,"list"++lay,false,@{'!',w=800,h=600})
      pico.zet.layer("list"++lay)
      set lisLay = lay
      set lay = lay+1
      pico.zet.pencil @{color = 0x000000}
      pico.zet.pencil @{font = "DejaVuSans.ttf"}

      loop i in n {
         pico.output.draw.text(t[i],@{
            '%',x=0.1,y=0.15+(i*0.075),h=0.05,anchor=:W
         })
         pico.output.draw.oval @{'%',x=0.05,y=0.15+(i*0.075),h=0.02,w=0.02,anchor=:W}
       }
       pico.zet.layer("world")
    }
    updateLayer()

    set xpos = 0

    ifs{
       t.pos == :left => {
          set xpos = 0
       }
       t.pos == :right => {
          set xpos = 0.50
       }
    }


    par{
      if (t.anim){
         loop{
            val  _,e = await :key.dn
            match e.key{
               :Up => {
                  if n > 0 {
                     set n = n-1
                     updateLayer()
                  }
                }
                :Down => {
                   if n < #t{
                     set n = n+1
                     updateLayer()
                   }
                }
             }
          }
      }

   }with{
      ;;val xtest = xpos
      print("outside",xpos)
      every :draw {
         print("loop",xpos)
         pico.output.draw.layer("list"++lisLay,@{
            '%',x=xpos,y=0,anchor=:NW
         })
      }
   }
}

func ITS.Text (t) {
