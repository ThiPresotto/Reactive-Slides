var cur = 1
loop {
    print(:cur, cur)
    val t = T@cur
    pico.set.effect [
        color = (t.color && t.color.bg) || color.bg
    ]
    spawn TPL@(t.template)(t)
    loop {
        val e = await :key.dn
        match e.key {
            :Left => {
                if cur > 1 {
                    set cur = cur - 1
                    break()
                }
            }
            :Right => {
                if cur < #T {
                    set cur = cur + 1
                    break()
                }
            }
            :Escape => {
                return()
            }
        }
        
    }
}
