val ITS = []

set ITS.List = task (t) {
    var n = #t
    par{
       if (t.anim){
          set n = 0
          loop{
             val _,e = await :key.dn
             match e.key{
                :Up => {
                   if n > 0{
                      set n = n-1
                   }
                }
                :Down =>{
                   if n < #t {
                      set n = n+1
                   }
                }
             }
          }
       }       
    }with{
       loop on :draw {
           loop i in n {
               pico.output.draw.text(t@i, [
                   '%', x=0.1, y=0.15+(i*0.075), h=0.05, anchor=:W
               ])
               pico.output.draw.oval ['%',x=0.05,y=0.15+(i*0.075),h=0.02,w=0.02,anchor=:W]
           } 
       }
    }
}

set ITS.Queue = task (t) {
   
   val list = []   
   
   par{
      loop{
         val _,e = await :key.dn
         match e.key{
            :Q => {
               loop {
               val _,e = await :key.dn
;;-> TODO: CONVERTER PARA QUALQUER NÚMERO
;;-> TODO: NAO PERMITIR ARGUMENTO REPETIDO

                  match e.key {
                     :1 =>{
                        set list@+ = t@1
                     }
                     :2 =>{
                        set list@+ = t@2
                     }
                     :3 =>{
                        set list@+ = t@3
                     }
                     :Q =>{
                        break()
                     }
                  }
               }
            }
         }
      }
   }with{
      loop on :draw {
         loop i,v in list {
            pico.output.draw.text(v,[
               '%', x=0.1, y=0.15+(i*0.075),h=0.05,anchor=:W
            ])
         }
      }
   }
}

set ITS.ListL = task (t) {

   if t.anim {
       set n = 0
    } else {
       set n = #t
    }
   var lisLay

   func updateLayer(){

;;Layer information
;;==============================================================
      pico.layer.empty(nil,"list"++lay,false,['!',w=800,h=600])
      pico.set.layer("list"++lay)
      set lisLay = lay
      set lay = lay+1
      pico.set.pencil [color = 0x000000]
      pico.set.pencil [font = "DejaVuSans.ttf"]
;;==============================================================

      val skip = t.skip || 0.075
      
      if (t.btitle) {
         pico.output.draw.text(t.btitle,[
            '%',x=0.05,y=0.15 + skip,h=0.055, anchor=:W
         ])
      }

      val start_index = (t.btitle && 1) || 0
      loop i in n {
         pico.output.draw.text(t@i,[
            '%',x=0.1,y=0.15+((i+start_index)*skip),h=0.05,anchor=:W
         ])
       }
       if (((t.bullet == nil) && true) || t.bullet){
          loop i in n{
             pico.output.draw.oval ['%',x=0.05,y=0.15+((i+start_index)*skip),h=0.02,w=0.02,anchor=:W]
          }
       }
       pico.set.layer("world")
    }
    updateLayer()

    var xpos = 0

    ifs{
       t.pos == :left => {
          set xpos = 0
       }
       t.pos == :right => {
          set xpos = 0.50
       }
    }


    par{
      if (t.anim){
         loop{
            val  _,e = await :key.dn
            match e.key{
               :Up => {
                  if n > 0 {
                     set n = n-1
                     updateLayer()
                  }
                }
                :Down => {
                   if n < #t{
                     set n = n+1
                     updateLayer()
                   }
                }
             }
          }
      }

   }with{
      loop on :draw {
         pico.output.draw.layer("list"++lisLay,[
            '%',x=xpos,y=0,anchor=:NW
         ])
      }
   }
}

