set ITS.ImageL = task (t) {
   pico.layer.empty(nil,"image"++lay,false,['!',w=800,h=600])
   pico.set.layer("image"++lay)
   var imaLay = lay
   set lay = lay + 1

   pico.output.draw.image(t@1,[
      '%',x=0.5,y=0.5,w=1,h=1
   ])
   pico.set.layer("world")

   val img = pico.get.image(t@1)

   var cell_x = t.xpos
   var cell_y = t.ypos
   var cell_width = t.width
   var cell_height = t.height

   var img_aspect = img.w / img.h
   var cell_aspect = cell_width / cell_height

   var final_width, final_height

   if img_aspect > cell_aspect {
      set final_width = cell_width
      set final_height = cell_width / img_aspect
   } else {
      set final_height = cell_height
      set final_width = cell_height * img_aspect
   }

   var parent = [
      '%', 
      x = cell_x - (final_width / 2), 
      y = cell_y - (final_height / 2),
      w = final_width,
      h = final_height
   ]
   
   var child = [
      '%', 
      x = 0.5, 
      y = 0.5
   ]

   var pos = pico.xin.pos(parent,child)
   set final_width  = final_width  * (t.size || 1) 
   set final_height = final_height * (t.size || 1)

   set pos.x = pos.x + (t.xshift || 0)
   set pos.y = pos.y + (t.yshift || 0)

   loop on :draw{
      await :Ok
      pico.output.draw.layer("image"++imaLay, [
          '%',x=pos.x,y=pos.y,w=final_width,h=final_height,anchor=:NW
      ])
   }
}

val TPL = []
set TPL.Cover = task (t) {
    var dim = ['%',h=0.1]
    var x = pico.get.text(dim,t.title)
    var title_lines = []
    var title_text = t.title || ""
    var font_size = 0.1
    var max_width = 0.8

    func wrap(text,max_width,font_size){
       

       var lines = []
       var words = []

       loop word in string.gmatch(text,"%S+"){
          table.insert(words,word)
       } 

       if #words == 0 => return(text)
 
       var current_line = ""
       loop i, word in words{
           var test_line = current_line
           if (test_line != "") {
              set test_line = test_line++" "++word
           }
           else {
              set test_line = word
           }

           var dim = ['%',h=font_size]
           pico.get.text(dim,test_line)

           if dim.w <= max_width { 
              set current_line = test_line
           }
           else {
              table.insert(lines,current_line)
              set current_line = word
           }

       }

        if current_line != "" => table.insert(lines,current_line)
        return(lines)
    }

    var title_lines = wrap(title_text, max_width, font_size)
    var start_y=0.2
    var line_height = font_size*1.2

    loop on :draw {
	pico.set.pencil [color = t.bgcolor || color.bg]
	pico.output.draw.rect ['%',x=0.5,y=0.5,w=1,h=1]
        pico.set.pencil [
            color = (t.color && t.color.fg) || color.fg
        ]

        loop i, line in title_lines{
           pico.output.draw.text(line,[
              '%',x=0.5,y=start_y+((i-1)*line_height),h=font_size
           ])
        }

        pico.output.draw.text(t.subtitle || "", [
            '%', x=0.5, y=0.3, h=0.075
        ])

        pico.output.draw.text(t.author || "", [
            '%', x=0.5, y=0.7,  h=0.05
        ])
        pico.output.draw.text(t.inst || "", [
            '%', x=0.5, y=0.75, h=0.05
        ])
        pico.output.draw.text(t.date || "", [
            '%', x=0.5, y=0.8,  h=0.05
        ])
    }
}
