      await :Ok
      pico.output.draw.layer("text"++texLay,[
          '%',x=pos.x,y=pos.y,anchor=:NW,
      ])
   }
}

set ITS.Table = task (t) {
   
   var head_total_width = 0 
   var heading_widths = [] 
   var spacing_width = 0.02 

   loop _, word in t.head{
      var measure = pico.get.text(['%',h=0.05],word)
      table.insert(heading_widths,measure.w)
      set head_total_width = head_total_width + measure.w
   }

   var start_x = 0.5 - (((spacing_width*(#t.head-1))+head_total_width)/2)
   val total_width = head_total_width + (spacing_width * (#t.head-1))

   loop on :draw {
 
      var current_x = start_x      

;;Headings
      loop i, word in t.head{
         pico.output.draw.text(word,[
            '%',x = current_x, y= 0.3,h=0.05,anchor=:W
         ])
         set current_x = current_x + heading_widths@i +spacing_width 
      }
 
      var row_y = 0.4

      pico.output.draw.rect ['%',x=start_x,y=0.35,w=total_width,h=0.005,anchor=:NW]



;;Rows
      loop i in #t{
         var row = t@i
         var current_x = start_x
         loop j, cell in row{
            pico.output.draw.text(cell,[
               '%',x=current_x, y=row_y,h=0.04,anchor=:W
            ])
            set current_x = current_x + heading_widths@j +spacing_width 
         }
         set row_y = row_y + 0.05
      }
  
;;Vertical Separator
   var sep_x = start_x
   loop i in #t.head-1{
      set sep_x = sep_x + heading_widths@i + spacing_width
      pico.output.draw.rect ['%',x=sep_x-(spacing_width/2),y=0.3,w=0.003,h=row_y-0.3,anchor=:NW]
   }

      pico.output.draw.rect ['%',x=start_x,y=row_y,w=total_width,h=0.005,anchor=:W]
   }
}

