set TPL.Ref = task (t) {
  
   var cur_idx = 1
   var tot_ref = #t
   var current_ref = t@cur_idx

   task drawRef(ref){
      pico.set.pencil [
         color = color.fg
      ]
      loop on :draw{

         pico.output.draw.text("REFERENCES", [
            '%',x=0.5,y=0.08,h=0.075
         ])

         pico.output.draw.text(ref.title,[
            '%', x=0.5, y=0.3,h=0.05
         ])

         var author_text = table.concat(ref.author, "; ")
         pico.output.draw.text(author_text,[
            '%',x=0.5,y=0.4,h=0.04
         ])
 
         pico.output.draw.text(cur_idx++"/"++tot_ref,[
            '%', x=0.85, y=0.08,h=0.06,anchor = :E
         ])
      }
   }

   loop{
      par :any{
         val e = await :key.dn
         match e.key {
            :Up =>{
               if (cur_idx <= 1) => break() ;;possibilidade de continue?
               set cur_idx = cur_idx - 1
               set current_ref = t@cur_idx
            }
            :Down =>{
               if (cur_idx >= #t) => break()
               set cur_idx = cur_idx + 1
               set current_ref = t@cur_idx
            }
         }
      }with{
         spawn drawRef(t@cur_idx)
         await(false)
      }
   }
}

