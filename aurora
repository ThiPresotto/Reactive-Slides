set TPL.Ref = task (t) {
  
   var cur_ref = 1
   var tot_ref = #t

   task drawRef(t){
      pico.set.pencil [
         color = (t.color && t.color.fg) || color.fg
      ]
      loop on :draw{
         pico.output.draw.text(t.title,[
            '%', x=0.5, y=0.3,h=0.04
         ])
         pico.output.draw.text(cur_ref++"/"++tot_ref,[
            '%', x=0.8, y=0.3,h=0.08
         ])
      }
   }

   par{
      loop{
         par{
            val _,e = await :key.dn
            match e.key {
               :Up =>{
                  if (cur_ref <= 1) => break()
                  cur_ref - 1
               }
               :Down =>{
                  if (cur_ref >= #t) => break()
                  cur_ref + 1
               }
            }
         }with{
            spawn drawRef(t[cur_ref])
            await(false)
         }
      }
   }with{
      loop on :draw{
         pico.set.pencil [
            color = (t.color && t.color.fg) || color.fg
         ]
         pico.output.draw.text("REFERENCE", [
            '%', x=0.2, y=0.1, h =0.075
         ])
      }
   }
}

