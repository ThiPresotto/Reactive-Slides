require "atmos.env.pico"
val pico = require "pico"

val color = @{
    bg = 'white',
    fg = 'black',
}

pico.zet.window @{ title="Apresentação" }
pico.zet.dim @{'!', w=800, h=600}
pico.zet.pencil @{
    font = "DejaVuSans.ttf"
}

val filename = ...
val T = dofile(filename)
 
val ITS = @{}
func ITS.List (t) {
    pico.layer.empty(nil,"dot",false,@{'!',w=100,h=100})
    pico.zet.layer("dot") 
    pico.zet.pencil @{color = "black"}
    pico.output.draw.oval @{'%',x=0.5,y=0.5,w=1,h=1}
    pico.zet.layer("world")
    var n = #t
    par{
       if (t.anim){
          set n = 0
          loop{
             val _,e = await :key.dn
             match e.key{
                :Up => {
                   if n > 0{
                      set n = n-1
                   }
                }
                :Down =>{
                   if n < #t {
                      set n = n+1
                   }
                }
             }
          }
       }       
    }with{
       every :draw {
           loop i in n {
               pico.output.draw.text(t[i], @{
                   '%', x=0.1, y=0.15+(i*0.075), h=0.05, anchor=:W
               })
               pico.output.draw.layer("dot",@{
                   '%', x=0.05,y=0.15+(i*0.075), h=0.02, w=0.02, anchor=:W
               })
           } 
       }
    }
}

func ITS.Text (t) {
   val lines = @{}
   loop line in t[1]::gmatch("([^\r\n]+)"){
      table.insert(lines,line)
   }
   every :draw {
      loop i in #lines {
            pico.output.draw.text(lines[i], @{
                '%', x=0.1, y=0.15+(i*0.075), h=0.05, anchor=:W
            })
        }
   }
}

func ITS.Image (t) {
   val img = pico.get.image("C_logo.png") 
   var dh, dw
   if img.w >= img.h {
      set dw = 0.5
      val f = 0.5/img.w
      set dh = img.h * f 
   }
   else {
      set dh = 0.5
      val f = 0.5/img.h
      set dw = img.w * f
   }
every :draw {
      pico.output.draw.image(t[1], @{
		  '%', x=0.5,y=0.5,w=dw,h=dh
      })
      pico.output.draw.rect @{'%',x=0,y=0,w=1.0,h=0.08,anchor='NW'}
   }
}

val TPL = @{}
func TPL.Cover (t) {
    every :draw {
        pico.zet.pencil @{
            color = (t.color && t.color.fg) || color.fg
        }

        ;; title, subtitle
        pico.output.draw.text(t.title || "", @{
            '%', x=0.5, y=0.2, h=0.1
        })
        pico.output.draw.text(t.subtitle || "", @{
            '%', x=0.5, y=0.3, h=0.075
        })

        ;; author, institution, date
        pico.output.draw.text(t.author || "", @{
            '%', x=0.5, y=0.7,  h=0.05
        })
        pico.output.draw.text(t.inst || "", @{
            '%', x=0.5, y=0.75, h=0.05
        })
        pico.output.draw.text(t.date || "", @{
            '%', x=0.5, y=0.8,  h=0.05
        })
    }
}

func TPL.One (t) {
    val one = t[1]
print(one.tag)
    spawn ITS[one.tag](one)
    every :draw {
        pico.zet.pencil @{
            color = (t.color && t.color.fg) || color.fg
        }
        pico.output.draw.text(t.title || "", @{
            '%', x=0.5, y=0.1, h=0.075
        })
    }
}

func TPL.Many (t) { 
    if (#t < 2) {
       val one = t[1]
       spawn ITS[one.tag](one)
    }
    else {
        print("implementar mais de um template") 
    }
    every :draw {
        pico.zet.pencil @{
           color = (t.color && t.color.fg) || color.fg
        }
        pico.output.draw.text(t.title || "", @{
           '%',x=0.5,y=0.1,h=0.075
        })
    }
}

var cur = 1
loop {
    print(:cur, cur)
    val t = T[cur]
    pico.zet.effect @{
        color = (t.color && t.color.bg) || color.bg
    }
    spawn TPL[t.template](t)
    loop {
        val _,e = await :key.dn
        match e.key {
            :Left => {
                if cur > 1 {
                    set cur = cur - 1
                    break()
                }
            }
            :Right => {
                if cur < #T {
                    set cur = cur + 1
                    break()
                }
            }
            :Escape => {
                return()
            }
        }
        
    }
}
