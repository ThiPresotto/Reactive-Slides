set ITS.List = task (t) {
    var n = #t
    par{
       if (t.anim){
          set n = 0
          loop{
             val e = await :key.dn
             match e.key{
                :Up => {
                   if n > 0{
                      set n = n-1
                   }
                }
                :Down =>{
                   if n < #t {
                      set n = n+1
                   }
                }
             }
          }
       }       
    }with{
       loop on :draw {
           loop i in n {
               pico.output.draw.text(t@i, [
                   '%', x=0.1, y=0.15+(i*0.075), h=0.05, anchor=:W
               ])
               pico.output.draw.oval ['%',x=0.05,y=0.15+(i*0.075),h=0.02,w=0.02,anchor=:W]
           } 
       }
    }
}

